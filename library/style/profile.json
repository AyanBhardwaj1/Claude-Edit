  "notes": [
    {
      "id": "074328e8",
      "text": "One 16:9 video only; don't make a vertical version unless asked",
      "scope": "kind:launch",
      "date": "2026-10-27",
      "source": ""
    },
    {
      "id": "414f8f4d",
      "text": "No voiceover: music and sound effects only, mixed at full quality (AAC 320k, about -14 LUFS)",
      "scope": "kind:launch",
      "date": "2026-10-27",
      "source": ""
    },
    {
      "id": "f3cee412",
      "text": "Premium, professional feel: near-black backgrounds, accent colour used sparingly, serif-italic accent words",
      "scope": "kind:launch",
      "date": "2026-10-27",
      "source": ""
    },
    {
      "id": "653924f7",
      "text": "Show the real product UI and only true, sourced claims (cite the source on screen for any price or statistic); paint out dev artifacts like debug badges and personal emails",
      "scope": "kind:launch",
      "date": "2026-10-27",
      "source": ""
    },
    {
      "id": "76c6e66b",
      "text": "Audience: small hedge funds; position YouBank as a cheaper alternative to a Bloomberg terminal, with a non-affiliation line",
      "scope": "brand:youbank",
      "date": "2026-10-27",
      "source": ""
    },
    {
      "id": "4ee0214e",
      "text": "Never ask the user to paste API keys into chat; keys go in .env",
      "scope": "global",
      "date": "2026-10-27",
      "source": ""
    },
    {
      "id": "bf7d5d7c",
      "text": "Use the live site youbank-nu.vercel.app: real UI recorded from it, its address in the browser bar and on the end card",
      "scope": "brand:youbank",
      "date": "2026-10-30",
      "source": ""
    },
    {
      "id": "b42fab30",
      "text": "YouBank videos: show the app in its Lavender UI style (light, violet accent #7c3aed) with a matching lavender-light video look and violet logo; not the amber-on-black Terminal style",
      "scope": "brand:youbank",
      "date": "2026-10-30",
      "source": ""
    },
    {
      "id": "b4822aff",
      "text": "Investor (VC fundraising) videos: dark cinematic, near-black with violet glow, Lavender product UI inside, sourced market figures; no invented traction",
      "scope": "brand:youbank",
      "date": "2026-10-31",
      "source": ""
    },
    {
      "id": "c4828fe9",
      "text": "Music and ambience must sit well under on-camera dialogue and skits; we have to hear ourselves clearly",
      "scope": "global",
      "date": "2026-11-06",
      "source": ""
    },
    {
      "id": "f5139933",
      "text": "When we're short on time, do it fast and send a draft; when asked, spend more time for better quality",
      "scope": "global",
      "date": "2026-11-06",
      "source": ""
    },
    {
      "id": "c7bc67a0",
      "text": "Walk-Free demo look (approved): app screens on an ivory frame with rounded corners and soft shadow, push-ins and punch-ins, small Meta model pills, captions in a dark box, checklist and chips graphics, logo sting, hot-to-cool grade, end card over a blurred freeze-frame",
      "scope": "brand:walk-free",
      "date": "2026-11-06",
      "source": ""
    },
    {
      "id": "df2f2377",
      "text": "Productions (demo videos): app screens framed on an ivory backdrop at 92%, phrase captions in a dark box up to 42 characters, mastered to -14 LUFS, plus a square cut of the key segment",
      "scope": "kind:production",
      "date": "2026-11-06",
      "source": ""
    }
  ]
